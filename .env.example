# QUALUTION Workspace Environment Template

# Frontend Settings (qualution-frontend/.env)
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
VITE_ELEVENLABS_API_KEY=
VITE_ENABLE_MARIO_ENGINE=false

# Supabase Client Configuration (Frontend - public anon key ONLY)
# CRITICAL SECURITY RULE: NEVER commit or expose the service-role key in frontend code or .env!
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...your-anon-key-here

# Backend Settings (qualution-backend/.env)
# LLM Providers for Mario Socratic Engine
GROQ_API_KEY=your-groq-api-key
NVIDIA_API_KEY=your-nvidia-api-key

# Supabase Server / CLI Configuration (Local & Migrations Only)
# SUPABASE_ACCESS_TOKEN=your-personal-access-token
# SUPABASE_DB_PASSWORD=your-db-password


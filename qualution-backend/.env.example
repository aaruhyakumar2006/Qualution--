# ==============================================================================
# QUALUTION Backend Environment Configuration Template
# All secrets must be provided in your local .env file.
# Never commit real secrets or production keys to version control.
# ==============================================================================

# Database Connection (PostgreSQL with pgvector)
# Pooled connection string to Supabase PostgreSQL or local instance
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:[PORT]/postgres

# Supabase Project Credentials (Backend Service-Role ONLY - Never expose to frontend!)
SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...[SERVICE_ROLE_KEY]
SUPABASE_DB_PASSWORD=[DB_PASSWORD]

# AI Providers (NVIDIA NIM primary reasoning, Groq pedagogical optimization)
NVIDIA_API_KEY=nvapi-[YOUR_NVIDIA_API_KEY]
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_CONNECT_TIMEOUT=10.0
NVIDIA_READ_TIMEOUT=35.0
NVIDIA_REQUEST_TIMEOUT=45.0
NVIDIA_MAX_RETRIES=1
NVIDIA_RETRY_BACKOFF=1.5

GROQ_API_KEY=gsk_[YOUR_GROQ_API_KEY]
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_CONNECT_TIMEOUT=5.0
GROQ_READ_TIMEOUT=15.0

# Community Telemetry Portal Ingestion & Caching
# Secret token required in 'X-Ingestion-Secret' header for manual ingestion trigger
INGESTION_SECRET=your_secure_ingestion_trigger_secret_here
# Ingestion job interval in minutes for APScheduler background runner
INGESTION_INTERVAL_MINUTES=60
# Default requests-per-minute rate limit applied per ingestion source
SOURCE_DEFAULT_RATE_LIMIT_PER_MINUTE=30
# Pagination settings for GET /api/v1/portal/items
PORTAL_PAGE_SIZE_DEFAULT=10
PORTAL_PAGE_SIZE_MAX=50
# In-memory portal cache TTL in seconds
PORTAL_CACHE_TTL_SECONDS=300
# Batch size for newly discovered items passed to AI enrichment
ENRICHMENT_BATCH_SIZE=5
ENRICHMENT_RETRY_COUNT=1
ENRICHMENT_TIMEOUT_SECONDS=30.0

# Client-Side Dexie Offline Storage Target Count
DEXIE_CACHE_SIZE=50

# Community Telemetry Submissions, Screening & Moderation (Phase 1)
# Maximum characters for signal titles and author notes
SUBMISSION_MAX_TITLE_LENGTH=120
SUBMISSION_MAX_NOTE_LENGTH=1000
# Per-user submission rate limits (sliding window)
SUBMISSION_RATE_LIMIT_PER_MINUTE=5
SUBMISSION_RATE_LIMIT_PER_DAY=50
REPORT_RATE_LIMIT_PER_MINUTE=10
# Roles whose submissions are auto-approved to public feed (JSON array)
AUTO_APPROVE_ROLES=["teacher", "admin", "moderator"]
# AI screening spam score threshold (0.0 to 1.0) above which posts are automatically rejected
AUTO_REJECT_SPAM_THRESHOLD=0.80
# Anonymize author handles in public responses (true/false)
PORTAL_ANONYMIZE_COMMUNITY_AUTHORS=false

# Cross-Origin Resource Sharing (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176,http://127.0.0.1:3000,http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:5175,http://127.0.0.1:5176
